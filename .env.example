# Copy this file to .env and fill in the values. Never commit .env.

# n8n encrypts saved credentials with this key. Generate a long random string.
N8N_ENCRYPTION_KEY=

# Shared secret between n8n and the worker (Authorization: Bearer <token>).
WORKER_TOKEN=

# LLM: openrouter for staging, anthropic for production.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
ANTHROPIC_API_KEY=

# Safety: keep AUTO_SUBMIT=false. LinkedIn and JobStreet ban bots.
DAILY_CAP=10
AUTO_SUBMIT=false

# Google OAuth client (used inside n8n credentials).
GOOGLE_CLOUD_CLIENT_ID=
GOOGLE_CLOUD_CLIENT_SECRET=
